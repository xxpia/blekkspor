{
    "id": "day-and-night",
    "title": "day and night;",
    "summary": "Day and night;",
    "category": "poem",
    "categoryLabel": "dikt",
    "date": "februar 2013",
    "sortYear": 2013,
    "content": "<p class=\"text-center\">Day and night;</p>\n\n<p class=\"text-center\">You held me tight.</p>\n\n<p class=\"text-center\">Night and day;</p>\n\n<p class=\"text-center\">Love, would I say.</p>\n\n<p class=\"text-center\">Living or dead;</p>\n\n<p class=\"text-center\">You were always in my head.</p>\n\n<p class=\"text-center\">Dead or living;</p>\n\n<p class=\"text-center\">Now I'm the one who's shivering.</p>",
